    </mxCell>
    <mxCell id="sh3" value="③ VECTOR STORAGE" style="text;html=1;fontStyle=1;fontSize=10;fontColor=#555;align=center;" vertex="1" parent="1">
      <mxGeometry x="590" y="48" width="200" height="18" as="geometry"/>
