    <mxCell id="e_dist_thresh" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="dist_metric" target="threshold" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e_thresh_rank" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="threshold" target="ranker" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e_rank_pr" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="ranker" target="pos_result" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e_rank_cr" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="ranker" target="cand_result" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e_cr_exp" style="edgeStyle=orthogonalEdgeStyle;dashed=1;" edge="1" source="cand_result" target="explain" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

