    <mxCell id="e_dbp_qvec" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="db_pos" target="query_vec" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e_qvec_excl" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="query_vec" target="excl" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
