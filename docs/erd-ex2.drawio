    <!-- Within candidates cluster: 120px left corridor, 5 tracks at x=10,30,50,70,90 (20px separation) -->
    <!-- All coords relative to cand_cluster; tables now start at x=120 -->

    <!-- e_csk: track x=10; exit from candidates left at y=126 (exitY=0.2); entry cskills center y=522 -->
